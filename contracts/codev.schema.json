{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "client_kind": {
          "enum": [
            "native",
            "browser",
            "vscode_compatibility"
          ],
          "title": "Client Kind",
          "type": "string"
        },
        "local_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Local Profile Id",
          "type": "string"
        },
        "online_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Online Account Id"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "surface": {
          "enum": [
            "local",
            "marketplace",
            "forge"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "local_profile_id",
        "client_id",
        "client_kind",
        "surface"
      ],
      "title": "Actor",
      "type": "object"
    },
    "BrokerPolicy": {
      "additionalProperties": false,
      "properties": {
        "clock_skew_seconds": {
          "const": 30,
          "default": 30,
          "title": "Clock Skew Seconds",
          "type": "integer"
        },
        "host": {
          "const": "127.0.0.1:47321",
          "default": "127.0.0.1:47321",
          "title": "Host",
          "type": "string"
        },
        "max_body_bytes": {
          "const": 2097152,
          "default": 2097152,
          "title": "Max Body Bytes",
          "type": "integer"
        },
        "origin": {
          "const": "http://127.0.0.1:47321",
          "default": "http://127.0.0.1:47321",
          "title": "Origin",
          "type": "string"
        },
        "port": {
          "const": 47321,
          "default": 47321,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "BrokerPolicy",
      "type": "object"
    },
    "BrokerProof": {
      "additionalProperties": false,
      "properties": {
        "browser_session_id": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Browser Session Id",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[A-Za-z0-9_-]{32,64}$",
          "title": "Nonce",
          "type": "string"
        },
        "online_account_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Online Account Id",
          "type": "string"
        },
        "pairing_id": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Pairing Id",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature",
          "type": "string"
        },
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        }
      },
      "required": [
        "pairing_id",
        "browser_session_id",
        "online_account_id",
        "nonce",
        "timestamp_ms",
        "signature"
      ],
      "title": "BrokerProof",
      "type": "object"
    },
    "BrokerRequest": {
      "additionalProperties": false,
      "properties": {
        "payload_json": {
          "maxLength": 2097152,
          "title": "Payload Json",
          "type": "string"
        },
        "proof": {
          "$ref": "#/$defs/BrokerProof"
        }
      },
      "required": [
        "proof",
        "payload_json"
      ],
      "title": "BrokerRequest",
      "type": "object"
    },
    "BrokerResponse": {
      "additionalProperties": false,
      "properties": {
        "payload_json": {
          "maxLength": 2097152,
          "title": "Payload Json",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "payload_json",
        "signature"
      ],
      "title": "BrokerResponse",
      "type": "object"
    },
    "BrowserApproveRequest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "explicitly_approved": {
          "default": false,
          "title": "Explicitly Approved",
          "type": "boolean"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Plan Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "revision",
        "content_hash",
        "grant_epoch",
        "plan_id",
        "plan_hash"
      ],
      "title": "BrowserApproveRequest",
      "type": "object"
    },
    "BrowserCancelRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^codev_[a-f0-9]{32}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "BrowserCancelRequest",
      "type": "object"
    },
    "BrowserChatRequest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "message": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "pattern": "^codev_[a-f0-9]{32}$",
          "title": "Request Id",
          "type": "string"
        },
        "requested_gear": {
          "default": "standard",
          "title": "Requested Gear",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "revision",
        "content_hash",
        "grant_epoch",
        "message",
        "request_id"
      ],
      "title": "BrowserChatRequest",
      "type": "object"
    },
    "BrowserPatchRequest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "edits": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Edits",
          "type": "object"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "revision",
        "content_hash",
        "grant_epoch",
        "summary",
        "edits"
      ],
      "title": "BrowserPatchRequest",
      "type": "object"
    },
    "BrowserPublicKey": {
      "additionalProperties": false,
      "properties": {
        "crv": {
          "const": "P-256",
          "default": "P-256",
          "title": "Crv",
          "type": "string"
        },
        "kty": {
          "const": "EC",
          "default": "EC",
          "title": "Kty",
          "type": "string"
        },
        "x": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "title": "X",
          "type": "string"
        },
        "y": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "BrowserPublicKey",
      "type": "object"
    },
    "BrowserRevisionRequest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "revision",
        "content_hash",
        "grant_epoch"
      ],
      "title": "BrowserRevisionRequest",
      "type": "object"
    },
    "BrowserWorkspaceShare": {
      "additionalProperties": false,
      "properties": {
        "base_revision": {
          "minimum": 0,
          "title": "Base Revision",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "current_revision": {
          "minimum": 0,
          "title": "Current Revision",
          "type": "integer"
        },
        "draft_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Id"
        },
        "expected_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Expected Epoch",
          "type": "integer"
        },
        "explicitly_approved": {
          "title": "Explicitly Approved",
          "type": "boolean"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/WorkspaceFile"
          },
          "maxItems": 2000,
          "title": "Files",
          "type": "array"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "scopes": {
          "items": {
            "enum": [
              "read",
              "propose"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Scopes",
          "type": "array"
        },
        "surface": {
          "enum": [
            "marketplace",
            "forge"
          ],
          "title": "Surface",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "surface",
        "label",
        "base_revision",
        "current_revision",
        "content_hash",
        "files",
        "scopes",
        "explicitly_approved"
      ],
      "title": "BrowserWorkspaceShare",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "id",
        "available"
      ],
      "title": "Capability",
      "type": "object"
    },
    "ChangePlan": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "base_revision": {
          "minimum": 0,
          "title": "Base Revision",
          "type": "integer"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "maxItems": 20,
          "title": "Changes",
          "type": "array"
        },
        "command_argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Command Argv",
          "type": "array"
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "cwd_label": {
          "title": "Cwd Label",
          "type": "string"
        },
        "expected_checks": {
          "items": {
            "type": "string"
          },
          "title": "Expected Checks",
          "type": "array"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "network_policy": {
          "const": "none",
          "default": "none",
          "title": "Network Policy",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "recovery_note": {
          "title": "Recovery Note",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        },
        "workspace_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workspace Hash",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "workspace_id",
        "actor",
        "base_revision",
        "workspace_hash",
        "grant_epoch",
        "plan_hash",
        "summary",
        "cwd_label",
        "expires_at",
        "recovery_note"
      ],
      "title": "ChangePlan",
      "type": "object"
    },
    "ClientLifecycle": {
      "additionalProperties": false,
      "description": "Independent axes; pairing and installation never grant a workspace.",
      "properties": {
        "installation": {
          "$ref": "#/$defs/Installation"
        },
        "network_pairing": {
          "default": "disconnected",
          "enum": [
            "disconnected",
            "connected",
            "revoked"
          ],
          "title": "Network Pairing",
          "type": "string"
        },
        "workspace_authority": {
          "default": "no_workspace",
          "enum": [
            "no_workspace",
            "workspace_read",
            "approval_needed",
            "executing",
            "revoked"
          ],
          "title": "Workspace Authority",
          "type": "string"
        }
      },
      "required": [
        "installation"
      ],
      "title": "ClientLifecycle",
      "type": "object"
    },
    "CorePackageManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Adapter Sha256",
          "type": "string"
        },
        "architecture": {
          "const": "amd64",
          "default": "amd64",
          "title": "Architecture",
          "type": "string"
        },
        "contract": {
          "const": "codev-core-1",
          "default": "codev-core-1",
          "title": "Contract",
          "type": "string"
        },
        "core_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Core Sha256",
          "type": "string"
        },
        "product": {
          "const": "codev-core",
          "default": "codev-core",
          "title": "Product",
          "type": "string"
        },
        "runtime_contract": {
          "const": "elysia-local-runtime-1",
          "default": "elysia-local-runtime-1",
          "title": "Runtime Contract",
          "type": "string"
        },
        "version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "core_sha256",
        "adapter_sha256"
      ],
      "title": "CorePackageManifest",
      "type": "object"
    },
    "ExactApproval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "command_argv": {
          "items": {
            "type": "string"
          },
          "title": "Command Argv",
          "type": "array"
        },
        "consumed": {
          "default": false,
          "title": "Consumed",
          "type": "boolean"
        },
        "cwd_label": {
          "title": "Cwd Label",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "grant_epoch": {
          "minimum": 1,
          "title": "Grant Epoch",
          "type": "integer"
        },
        "network_policy": {
          "default": "none",
          "enum": [
            "none",
            "approved_remote_save"
          ],
          "title": "Network Policy",
          "type": "string"
        },
        "one_time": {
          "const": true,
          "default": true,
          "title": "One Time",
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "patch_apply",
            "command_run",
            "browser_patch",
            "remote_save"
          ],
          "title": "Operation",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "workspace_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Workspace Hash",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "actor",
        "workspace_id",
        "revision",
        "workspace_hash",
        "grant_epoch",
        "operation",
        "plan_hash",
        "cwd_label",
        "expires_at"
      ],
      "title": "ExactApproval",
      "type": "object"
    },
    "FileChange": {
      "additionalProperties": false,
      "properties": {
        "base_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Base Hash",
          "type": "string"
        },
        "diff": {
          "maxLength": 262144,
          "title": "Diff",
          "type": "string"
        },
        "new_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "New Hash",
          "type": "string"
        },
        "new_text": {
          "maxLength": 131072,
          "title": "New Text",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "base_hash",
        "new_text",
        "new_hash",
        "diff"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "Installation": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "contract_version": {
          "const": "codev-client-1",
          "default": "codev-client-1",
          "title": "Contract Version",
          "type": "string"
        },
        "contract_versions": {
          "items": {
            "type": "string"
          },
          "title": "Contract Versions",
          "type": "array"
        },
        "expected_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Expected Version",
          "type": "string"
        },
        "installation_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installation Id"
        },
        "installation_state": {
          "default": "absent",
          "enum": [
            "absent",
            "installed",
            "incompatible"
          ],
          "title": "Installation State",
          "type": "string"
        },
        "installed": {
          "default": false,
          "title": "Installed",
          "type": "boolean"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "raw_paths_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Paths Exposed",
          "type": "boolean"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{48}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "runtime_state": {
          "default": "disconnected",
          "enum": [
            "disconnected",
            "ready",
            "degraded"
          ],
          "title": "Runtime State",
          "type": "string"
        },
        "session_state": {
          "default": "approval_needed",
          "enum": [
            "approval_needed",
            "ready"
          ],
          "title": "Session State",
          "type": "string"
        },
        "source": {
          "default": "none",
